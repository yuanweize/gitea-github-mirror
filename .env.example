# ==============================================================================
# Gitea GitHub Mirror v2 - Environment Configuration
# ==============================================================================
# Copy this file to `.env` and fill in your values.
# ==============================================================================

# --- Required ---

# Your Gitea instance base URL (no trailing slash)
GITEA_URL=https://git.example.com

# Gitea personal access token (Settings -> Applications -> Generate Token)
GITEA_TOKEN=your_gitea_token_here

# The Gitea username who will own the mirrored repositories
GITEA_USER=your_gitea_username

# GitHub personal access token (with `repo` scope for private repos)
# Generate at: https://github.com/settings/tokens
# If not set, the script will prompt interactively.
GITHUB_TOKEN=your_github_token_here

# Your GitHub username (used to identify owner repos vs org/collab repos)
GITHUB_USER=your_github_username

# --- Optional ---

# Mirror synchronization interval (Gitea format, e.g., '8h0m0s')
# MIRROR_INTERVAL=8h0m0s

# Number of concurrent worker threads (default: 5)
# Each worker independently waits for Gitea to return HTTP 201.
# Increase for faster throughput; decrease if your server is resource-limited.
# MAX_WORKERS=5

# HTTP request timeout per migration in seconds (default: 600)
# Must be long enough for Gitea to fully clone the largest repo.
# If behind Nginx, also increase proxy_read_timeout to match.
# REQUEST_TIMEOUT=600

# Max retry attempts for transient errors like 5xx (default: 3)
# MAX_RETRIES=3

# Initial retry delay in seconds; doubles each attempt (default: 10)
# RETRY_DELAY=10

# Logging level: DEBUG, INFO, WARNING, ERROR (default: INFO)
# LOG_LEVEL=INFO

# Max archived report files to keep (default: 50)
# REPORT_MAX_COUNT=50

# UI language: 'en' for English, 'cn' for 简体中文 (default: en)
# LANG_MIRROR=en
