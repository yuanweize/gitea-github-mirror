# ==============================================================================
# Gitea GitHub Mirror - Environment Configuration
# ==============================================================================
# Copy this file to `.env` and fill in your values.
# All variables prefixed with (Required) MUST be set.
# Variables prefixed with (Optional) have sane defaults.
# ==============================================================================

# --- Required ---

# Your Gitea instance base URL (no trailing slash)
GITEA_URL=https://git.example.com

# Gitea personal access token (Settings -> Applications -> Generate Token)
GITEA_TOKEN=your_gitea_token_here

# The Gitea username who will own the mirrored repositories
GITEA_USER=your_gitea_username

# GitHub personal access token (with `repo` scope for private repos)
# Generate at: https://github.com/settings/tokens
GITHUB_TOKEN=your_github_token_here

# Your GitHub username (used to identify owner repos vs org/collab repos)
GITHUB_USER=your_github_username

# --- Optional ---

# Mirror synchronization interval (Gitea cron format, e.g., '8h0m0s')
# Leave empty to use Gitea server default.
# MIRROR_INTERVAL=8h0m0s

# Maximum retry attempts for each failed repo migration (default: 3)
# MAX_RETRIES=3

# Initial retry delay in seconds; uses exponential backoff (default: 5)
# RETRY_DELAY=5

# Logging level: DEBUG, INFO, WARNING, ERROR (default: INFO)
# LOG_LEVEL=INFO

# Maximum number of archived report files to keep (default: 50)
# Oldest reports are auto-deleted when this limit is exceeded.
# REPORT_MAX_COUNT=50

# UI language: 'en' for English, 'cn' for 简体中文 (default: en)
# LANG_MIRROR=en
